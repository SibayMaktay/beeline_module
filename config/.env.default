# BeeLine
BEELINE_LOGIN= # login
BEELINE_PASSWORD= # password
BEELINE_URL_BASE=https://my.beeline.ru
BEELINE_REST_SIGNATURE= # secret signature

BEELINE_AUTH_WSDL=https://my.beeline.ru/api/AuthService?WSDL
BEELINE_SUBSCRIBER_WSDL=https://my.beeline.ru/api/SubscriberService?WSDL

# UTM5
UTM5_API_URL=http://127.0.0.1 #:9080
UTM5_LOGIN= # login
UTM5_PASSWORD= # password
UTM5_API_KEY= # api key utm5
# HTTP поведение
UTM5_TIMEOUT=30
UTM5_MAX_RETRIES=3
UTM5_RETRY_BACKOFF=0.5
UTM5_VERIFY_SSL=true
# Платежи (бизнес-параметры)
UTM5_PAYMENT_METHOD_ID=1
UTM5_CURRENCY_ID=1
UTM5_PAYMENT_COMMENT_PREFIX=Beeline
UTM5_TURN_ON_INET=1

# Module
MODULE_HOST=127.0.0.1
MODULE_PORT=9090
MODULE_API_KEY=bee_test # api key module beeline
MODULE_ADMIN_API_KEY=bee_test_admin # admin api key modyule beeline

# Логирование
LOG_LEVEL=INFO