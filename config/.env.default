# BeeLine API credentials
BEELINE_LOGIN= # login
BEELINE_PASSWORD= # password
BEELINE_AUTH_WSDL=https://my.beeline.ru/api/AuthService?WSDL
BEELINE_SUBSCRIBER_WSDL=https://my.beeline.ru/api/SubscriberService?WSDL

# UTM5 API credentials
UTM5_API_URL=http://127.0.0.1
UTM5_PORT=9080
UTM5_LOGIN= # login
UTM5_PASSWORD= # password
UTM5_API_KEY= # api key utm5

# Module settings
MODULE_HOST=127.0.0.1
MODULE_PORT=9090
MODULE_API_KEY= # api key module beeline

# Beeline config
BEELINE_URL_BASE=https://my.beeline.ru

# Логирование
LOG_LEVEL=INFO
LOG_FILE=/var/log/beeline_module/module.log
# REST статичный ключ (hash), опционально в демо
BEELINE_REST_SIGNATURE= # secret signature